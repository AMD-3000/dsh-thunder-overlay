{
  "name": "dsh-thunder-overlay",
  "version": "0.1.0",
  "description": "DSH Web GUI plugin: a full-frame white title-card that pops when a session starts working, naming what the agent is doing (user message, busy, tool calls, completion), with a settings page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "overlay",
    "ui",
    "client-plugin",
    "title-card"
  ],
  "license": "MIT"
}
